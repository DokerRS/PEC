{
  "manifest_version": 3,
  "name": "PEC - Proxy Extension Corp",
  "short_name": "PEC Corp",
  "version": "1.0.8",
  "description": "Корпоративное расширение Chrome для автоматической синхронизации HTTP/SOCKS5 прокси и ротируемой аутентификации.",
  "key": "",
  "update_url": "https://mini-server.ic.local/updates/updates.xml",
  "permissions": [
    "webRequest",
    "webRequestAuthProvider",
    "storage",
    "proxy",
    "alarms",
    "tabs",
    "privacy"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "minimum_chrome_version": "108",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "PEC - Proxy Extension Corp",
    "default_popup": "popup.html",
    "default_icon": "icon48.png"
  }
}